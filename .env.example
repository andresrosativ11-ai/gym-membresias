# Postgres. Local: `npm run db:dev` (prisma dev); pgbouncer=true es necesario solo con ese servidor local.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"
# Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Carpeta local para fotos (en producción se reemplaza por R2/S3)
STORAGE_DIR="./storage"
# Usuario admin inicial creado por `npm run db:seed`
SEED_ADMIN_EMAIL="admin@gym.local"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"

# --- WhatsApp Cloud API (Meta) — ver docs/whatsapp.md ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Opcionales (valores por defecto):
# WHATSAPP_API_VERSION="v23.0"
# WHATSAPP_TEMPLATE_LANG="es_MX"
# WHATSAPP_TEMPLATE_EXPIRING="membresia_por_vencer"
# WHATSAPP_TEMPLATE_EXPIRED="membresia_vencida"

# Secreto del cron diario de avisos (openssl rand -base64 32). Vercel Cron lo envía solo.
CRON_SECRET=""

# --- Email (Resend) — ver docs/email.md ---
RESEND_API_KEY=""
# Remitente con dominio verificado en Resend
EMAIL_FROM="Mi Gimnasio <avisos@tudominio.com>"
# Opcional: a dónde llegan las respuestas de los socios
# EMAIL_REPLY_TO="recepcion@tudominio.com"
